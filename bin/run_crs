#!/bin/bash
sysctl -w fs.file-max=2097152
ulimit -c 0
get_cp

MAIN_PID=""

# Function to save results
save_results() {
    if [ "$CRS_SKIP_SAVE" != "True" ] && [ -d "/artifacts" ]; then
        echo "=== Saving CRS results to /artifacts/ ==="

        # Create output directories
        mkdir -p /artifacts/povs /artifacts/corpus /artifacts/workdir_result

        # Find and copy results from each harness workdir
        for harness_dir in /crs-workdir/worker-*/HarnessRunner/*/; do
            if [ -d "$harness_dir" ]; then
                harness=$(basename "$harness_dir")
                echo "Saving results for harness: $harness"

                # Copy POVs
                if [ -d "$harness_dir/pov" ] && [ "$(ls -A "$harness_dir/pov" 2>/dev/null)" ]; then
                    mkdir -p /artifacts/povs/$harness
                    cp -r "$harness_dir/pov/"* /artifacts/povs/$harness/ 2>/dev/null || true
                fi

                # Copy corpus (from uniafl_corpus)
                if [ -d "$harness_dir/uniafl_corpus" ] && [ "$(ls -A "$harness_dir/uniafl_corpus" 2>/dev/null)" ]; then
                    mkdir -p /artifacts/corpus/$harness
                    cp -r "$harness_dir/uniafl_corpus/"* /artifacts/corpus/$harness/ 2>/dev/null || true
                fi

                # Copy full workdir
                mkdir -p /artifacts/workdir_result/$harness
                cp -r "$harness_dir"/* /artifacts/workdir_result/$harness/ 2>/dev/null || true
            fi
        done

        echo "=== Results saved ==="
        ls -la /artifacts/
    fi
}

# Cleanup function for signal handling
cleanup() {
    echo "=== Interrupted, saving results... ==="
    # Kill main.py if still running
    if [ -n "$MAIN_PID" ]; then
        kill -TERM $MAIN_PID 2>/dev/null
        wait $MAIN_PID 2>/dev/null
    fi
    save_results
    exit 130
}

# Trap signals - must be before main.py starts
trap cleanup INT TERM

# Run main.py in background so 'wait' is interruptible by signals
# This allows the trap to fire immediately when SIGTERM arrives
main.py &
MAIN_PID=$!
wait $MAIN_PID
EXIT_CODE=$?

# Save results on normal exit
save_results

exit $EXIT_CODE
